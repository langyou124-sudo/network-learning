# Supabase (认证 + 数据库)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 仅脚本需要（批量向量化写库）；前端与 API 路由不要用它
SUPABASE_SERVICE_ROLE_KEY=

# MiMo API (AI 问答)
MIMO_API_KEY=your-mimo-api-key

# Embedding（语义搜索 / RAG）
# provider: zhipu（默认）| openai（任何 OpenAI 兼容端点，如硅基流动、自建 vLLM）
EMBEDDING_PROVIDER=zhipu
EMBEDDING_MODEL=embedding-3
# zhipu 缺省时回落到下面的 ZHIPUAI_API_KEY
EMBEDDING_API_KEY=
# openai 协议时的根地址，脚本会自动补 /embeddings
EMBEDDING_BASE_URL=
# 显式维度；与 knowledge_chunks.embedding 的列维度不一致时，向量化脚本会提前报错
# 智谱 embedding-3 默认 2048，当前表也是 2048
EMBEDDING_DIMENSIONS=2048

# ZhipuAI（旧变量，仍被 EMBEDDING_API_KEY 回落使用）
ZHIPUAI_API_KEY=your-zhipuai-key

# Upstash Redis (速率限制，可选 — 不配置则使用内存限制)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
